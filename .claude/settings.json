{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx next *)",
      "Bash(node scripts/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.next/**)",
      "Read(./out/**)",
      "Read(./package-lock.json)",
      "Read(./assets/brand-source/**)",
      "Read(./qa-output/**/*.json)",
      "Read(./.claude/skills/aegis-web-kit/licenses/**)"
    ]
  }
}
